skinparam class {
  BackgroundColor<<config>> #EEE2FF
  BorderColor<<config>> #8B5CC7
  BackgroundColor<<evidence>> #D9EAFB
  BorderColor<<evidence>> #4C86BC
  BackgroundColor<<policy>> #FFF3CC
  BorderColor<<policy>> #B89B56
  BackgroundColor<<service>> #CDE4FA
  BorderColor<<service>> #397AB5
  BackgroundColor<<output>> #D4F3E2
  BorderColor<<output>> #3A9565
