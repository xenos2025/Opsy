skinparam ArrowThickness 1.4
skinparam packageStyle rectangle
skinparam packageBorderColor #64748B
skinparam packageBackgroundColor #F8FAFC
skinparam packageFontColor #334155
skinparam packageFontStyle bold
skinparam ClassAttributeIconSize 0
skinparam ClassBorderThickness 1.5
skinparam ClassBorderColor #334155
skinparam ClassBackgroundColor #DCEBFA
skinparam ClassHeaderBackgroundColor #8FC4F7
